# Career Compass — 서버(Vercel Functions) 환경변수 예시. 실제 secret은 커밋 금지.
# 값은 Vercel Dashboard → Settings → Environment Variables 에서 설정한다.

# ── Supabase ──
# 클라이언트 번들용(VITE_ 접두사는 브라우저에 노출됨 — anon 키만).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# 서버 전용(브라우저 노출 금지). RLS 우회하여 job 읽기/쓰기.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic ──
ANTHROPIC_API_KEY=

# ── QStash (Upstash) — background job ──
# Upstash Console → QStash 에서 발급.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ── App base URL ──
# QStash가 runner에 도달할 절대 public URL. 없으면 요청 헤더로 추정, 최후 prod 도메인.
# 예: https://career-compass-rose.vercel.app
PUBLIC_APP_URL=

# ── 운영자 전용(선택) ──
# /api/paid-job-retry 수동 재시도 보호용.
ADMIN_RETRY_SECRET=
